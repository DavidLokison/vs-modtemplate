<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <VintageStory Condition="'$(CI)' == 'true'">$(RUNNER_TEMP)/vintagestory</VintageStory>
    <VintageStory Condition="'$(VintageStory)' == ''">$(VINTAGE_STORY)</VintageStory>
  </PropertyGroup>
</Project>
