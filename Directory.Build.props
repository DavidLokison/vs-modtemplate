<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <VintageStory Condition="'$(CI)' == 'true'">$(RUNNER_TEMP)/vintagestory</VintageStory>
    <VintageStory Condition="'$(VintageStory)' == ''">$(VINTAGE_STORY)</VintageStory>
  </PropertyGroup>

  <Target Name="RemoveSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.xml'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').EndsWith('.deps.json'))" />
    </ItemGroup>
  </Target>
</Project>
